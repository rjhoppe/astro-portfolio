---
import PageLayout from "@layouts/PageLayout.astro";
import { UPLOAD, ASSIGNEES } from "@consts";

// Shared class definitions
const inputClass =
  "w-full border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-900 rounded-xl py-2.5 px-3 text-sm outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all placeholder:text-stone-400";

// Base styles for all buttons
const buttonBase =
  "relative inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm transition-all duration-200 active:scale-[0.98] disabled:opacity-50 disabled:pointer-events-none";

// Secondary (Outline style) - For Restore, Add Row, etc.
const buttonSecondary = `${buttonBase} border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 text-stone-700 dark:text-stone-200 hover:bg-stone-50 dark:hover:bg-stone-700 hover:border-stone-300 dark:hover:border-stone-600 shadow-sm`;

// Primary (Solid style) - For Submit/Save
const buttonPrimary = `${buttonBase} bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 hover:opacity-90 shadow-md shadow-stone-900/10`;
---

<PageLayout title={UPLOAD.TITLE} description={UPLOAD.DESCRIPTION}>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div
      id="header-block"
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-10 border-b border-stone-100 dark:border-stone-800 pb-8"
    >
      <div>
        <h1
          class="text-3xl font-bold tracking-tight text-stone-900 dark:text-white"
        >
          {UPLOAD.TITLE}
        </h1>
        <p class="text-stone-500 dark:text-stone-400 mt-1">
          {UPLOAD.DESCRIPTION}
        </p>
      </div>
      <div id="btn-group" class="flex items-center gap-3">
        <button id="restore-btn" type="button" class={buttonSecondary}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="opacity-60"
            ><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
            ></path><path d="M3 3v5h5"></path></svg
          >
          Restore
        </button>
        <button id="add-row-btn" type="button" class={buttonSecondary}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-indigo-500"
            ><line x1="12" y1="5" x2="12" y2="19"></line><line
              x1="5"
              y1="12"
              x2="19"
              y2="12"></line></svg
          >
          Add Record
        </button>
      </div>
    </div>

    <form id="form-block" class="space-y-6">
      <div id="entries" class="space-y-4"></div>

      <div
        class="mt-12 pt-8 border-t border-stone-100 dark:border-stone-800 flex flex-col sm:flex-row justify-between items-center gap-4"
      >
        <div class="flex items-center gap-2 text-stone-400">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
          >
          <span class="text-xs uppercase tracking-widest font-semibold"
            >Secure Database Sync</span
          >
        </div>
        <button
          id="submit-btn"
          type="submit"
          class={`${buttonPrimary} w-full sm:w-auto px-12 py-4 text-base shadow-indigo-500/10`}
        >
          Submit All Records
        </button>
      </div>
    </form>
  </div>

  <template id="gift-row-template">
    <div
      data-group="gift-entries"
      class="group relative bg-white dark:bg-stone-900/40 border border-stone-200 dark:border-stone-800 p-6 rounded-2xl shadow-sm hover:border-stone-300 dark:hover:border-stone-600 transition-all"
    >
      <button
        type="button"
        data-action="delete-row"
        class="absolute -top-2 -right-2 h-8 w-8 flex items-center justify-center bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 rounded-full text-stone-400 hover:text-red-500 hover:border-red-200 shadow-sm transition-all opacity-0 group-hover:opacity-100 focus:opacity-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line></svg
        >
      </button>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        <div class="md:col-span-3 flex flex-col gap-1.5">
          <label
            class="text-[10px] font-bold uppercase tracking-widest text-stone-400 dark:text-stone-500 ml-1"
            >Gift Name</label
          >
          <input
            class={inputClass}
            type="text"
            name="name"
            placeholder="Item name..."
            required
          />
        </div>

        <div class="md:col-span-3 flex flex-col gap-1.5">
          <label
            class="text-[10px] font-bold uppercase tracking-widest text-stone-400 dark:text-stone-500 ml-1"
            >Product URL</label
          >
          <input
            class={inputClass}
            type="url"
            name="link"
            placeholder="https://..."
            required
          />
        </div>

        <div class="md:col-span-2 flex flex-col gap-1.5">
          <label
            class="text-[10px] font-bold uppercase tracking-widest text-stone-400 dark:text-stone-500 ml-1"
            >Assign To</label
          >
          <select name="assignee" class={inputClass}>
            <option value="Unassigned" selected>Unassigned</option>
            {ASSIGNEES.map((val) => <option value={val}>{val}</option>)}
          </select>
        </div>

        <div class="md:col-span-1 flex flex-col gap-1.5">
          <label
            class="text-[10px] font-bold uppercase tracking-widest text-stone-400 dark:text-stone-500 ml-1"
            >Status</label
          >
          <select name="bought" class={inputClass}>
            <option value="No" selected>No</option>
            <option value="Yes">Yes</option>
          </select>
        </div>

        <div class="md:col-span-3 flex flex-col gap-1.5">
          <label
            class="text-[10px] font-bold uppercase tracking-widest text-stone-400 dark:text-stone-500 ml-1"
            >Notes</label
          >
          <input
            class={inputClass}
            type="text"
            name="notes"
            placeholder="Optional details..."
          />
        </div>
      </div>
    </div>
  </template>

  <!-- Script Block -->
  <script>
    document.addEventListener("astro:page-load", () => {
      const entriesContainer = document.getElementById("entries");
      const addRowBtn = document.getElementById("add-row-btn");
      const form = document.getElementById("form-block") as HTMLFormElement;
      const template = document.getElementById(
        "gift-row-template",
      ) as HTMLTemplateElement;

      // Exit if the necessary elements aren't on this page.
      // This makes the script safe to run on every page load.
      if (!entriesContainer || !addRowBtn || !form || !template) {
        return;
      }

      const addRow = () => {
        if (!template || !entriesContainer) return;
        // Clone the content of the template
        const clone = template.content.cloneNode(true);
        entriesContainer.appendChild(clone);
      };

      if (entriesContainer?.children.length === 0) {
        addRow();
      }

      addRowBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        addRow();
      });

      entriesContainer?.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        // Check for our custom data-action attribute
        if (target.dataset.action === "delete-row") {
          const rows = document.querySelectorAll("[data-group='gift-entries']");
          // Prevent deleting the very last row to keep the UI clean
          if (rows.length > 1) {
            target.closest("[data-group='gift-entries']")?.remove();
          } else {
            alert("You must have at least one entry.");
          }
        }
      });

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const giftEntries = document.querySelectorAll(
          "[data-group='gift-entries']",
        );
        const submitBtn = document.getElementById(
          "submit-btn",
        ) as HTMLButtonElement;

        // Disable UI during submission
        if (submitBtn) submitBtn.disabled = true;

        try {
          // Map entries to an array of promises
          const requests = Array.from(giftEntries).map(async (gift) => {
            const payload = {
              name: (
                gift.querySelector("input[name='name']") as HTMLInputElement
              ).value,
              link: (
                gift.querySelector("input[name='link']") as HTMLInputElement
              ).value,
              assignee: (
                gift.querySelector(
                  "select[name='assignee']",
                ) as HTMLSelectElement
              ).value,
              bought: (
                gift.querySelector("select[name='bought']") as HTMLSelectElement
              ).value,
              notes: (
                gift.querySelector("input[name='notes']") as HTMLInputElement
              ).value,
            };

            const response = await fetch("/api/gifts/submit", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });

            if (!response.ok) {
              const err = await response.json();
              throw new Error(err.message || "Failed to save an item.");
            }
            return response.json();
          });

          // Execute all requests
          await Promise.all(requests);

          alert("All gifts successfully added to the database");

          if (entriesContainer) {
            entriesContainer.innerHTML = "";
            addRow();
            form.reset();
          }
        } catch (err) {
          alert(
            `Error: ${err instanceof Error ? err.message : "Submission failed"}`,
          );
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  </script>
</PageLayout>
